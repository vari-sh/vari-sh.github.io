{
  "name": "Cremisi Ivory",
  "author": "vari.sh",
  "variables": {
    "ground": "#f4eee2",
    "ink": "#2b2733",
    "iron": "#64606c",
    "incense": "#8a7f8c",
    "crimson": "#c42740",
    "crimson_deep": "#7e1023",
    "blood": "#bb1f39",
    "lapis": "#2d5c9c",
    "tallow": "#7e6410",
    "amber": "#9f5c12",
    "sealwax": "#a24d20",
    "malachite": "#2f7a4e",
    "verdigris": "#1a706d",
    "amethyst": "#7e3a9e",
    "wine": "#8a3f64",
    "petal": "#a8465f",
    "border": "#e9e1d1",
    "gutter_fg": "#b3aa9a"
  },
  "globals": {
    "background": "var(ground)",
    "foreground": "var(ink)",
    "caret": "var(blood)",
    "line_highlight": "color(var(ink) alpha(0.05))",
    "selection": "color(var(crimson) alpha(0.24))",
    "selection_border": "var(crimson_deep)",
    "inactive_selection": "color(var(crimson) alpha(0.12))",
    "gutter": "var(ground)",
    "gutter_foreground": "var(gutter_fg)",
    "gutter_foreground_highlight": "var(blood)",
    "highlight": "var(blood)",
    "find_highlight": "var(amber)",
    "find_highlight_foreground": "var(ground)",
    "invisibles": "color(var(ink) alpha(0.10))",
    "guide": "color(var(ink) alpha(0.06))",
    "active_guide": "color(var(ink) alpha(0.16))",
    "stack_guide": "color(var(ink) alpha(0.10))",
    "brackets_foreground": "var(blood)",
    "bracket_contents_foreground": "var(blood)",
    "tags_foreground": "var(blood)",
    "accent": "var(crimson)",
    "line_diff_added": "var(malachite)",
    "line_diff_modified": "var(amber)",
    "line_diff_deleted": "var(blood)",
    "minimap_border": "var(border)",
    "shadow": "color(var(ground) alpha(0.6))"
  },
  "rules": [
    {
      "name": "Comments",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "var(incense)",
      "font_style": "italic"
    },
    {
      "name": "Keywords and declarations",
      "scope": "keyword - keyword.operator - source.regexp - string.regexp, storage.modifier - storage.modifier.conversion - storage.modifier.named-args-only - storage.modifier.positional-args-only - storage.modifier.optional - source.regexp - string.regexp, storage.type.function, storage.type.class",
      "foreground": "var(blood)",
      "font_style": "italic"
    },
    {
      "name": "Control flow",
      "scope": "keyword.control - keyword.control.import-export - source.regexp - string.regexp",
      "foreground": "var(blood)",
      "font_style": "bold"
    },
    {
      "name": "Imports",
      "scope": "keyword.control.import, keyword.control.at-rule, keyword.other.import, meta.preprocessor",
      "foreground": "var(wine)",
      "font_style": "italic"
    },
    {
      "name": "Operators",
      "scope": "keyword.operator, punctuation.accessor",
      "foreground": "var(wine)"
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, variable.function, support.function",
      "foreground": "var(lapis)",
      "font_style": "italic"
    },
    {
      "name": "Builtins and self",
      "scope": "support.function.builtin, variable.language",
      "foreground": "var(amethyst)",
      "font_style": "italic"
    },
    {
      "name": "Types",
      "scope": "storage.type, support.type, entity.name.type",
      "foreground": "var(tallow)",
      "font_style": "italic"
    },
    {
      "name": "Classes and namespaces",
      "scope": "entity.name.class, entity.name.struct, entity.name.namespace, support.class, entity.other.inherited-class",
      "foreground": "var(tallow)",
      "font_style": "italic"
    },
    {
      "name": "Strings",
      "scope": "string, string.quoted, string.unquoted",
      "foreground": "var(malachite)"
    },
    {
      "name": "Escapes and regex",
      "scope": "constant.character.escape, constant.other.placeholder, string.regexp",
      "foreground": "var(sealwax)"
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "foreground": "var(amber)"
    },
    {
      "name": "Language constants",
      "scope": "constant.language",
      "foreground": "var(blood)",
      "font_style": "bold italic"
    },
    {
      "name": "Other constants",
      "scope": "constant.other, variable.other.constant",
      "foreground": "var(amber)"
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "foreground": "var(petal)",
      "font_style": "italic"
    },
    {
      "name": "Variables",
      "scope": "variable, variable.other",
      "foreground": "var(ink)"
    },
    {
      "name": "Properties",
      "scope": "variable.other.member, variable.other.property",
      "foreground": "var(verdigris)"
    },
    {
      "name": "Decorators",
      "scope": "entity.name.decorator, meta.decorator, meta.annotation - meta.function-call.arguments, punctuation.definition.annotation",
      "foreground": "var(sealwax)"
    },
    {
      "name": "Attributes",
      "scope": "entity.other.attribute-name",
      "foreground": "var(tallow)",
      "font_style": "italic"
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag",
      "foreground": "var(blood)"
    },
    {
      "name": "Exceptions",
      "scope": "support.type.exception, support.class.exception",
      "foreground": "var(blood)",
      "font_style": "italic"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "var(iron)"
    },
    {
      "name": "Invalid",
      "scope": "invalid, invalid.illegal",
      "foreground": "#ffffff",
      "background": "var(crimson)"
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted",
      "foreground": "var(blood)"
    },
    {
      "name": "Diff inserted",
      "scope": "markup.inserted",
      "foreground": "var(malachite)"
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "foreground": "var(amber)"
    },
    {
      "name": "Markdown h1",
      "scope": "markup.heading.1",
      "foreground": "var(blood)",
      "font_style": "bold"
    },
    {
      "name": "Markdown h2",
      "scope": "markup.heading.2",
      "foreground": "var(amber)",
      "font_style": "bold"
    },
    {
      "name": "Markdown h3",
      "scope": "markup.heading.3",
      "foreground": "var(tallow)",
      "font_style": "bold"
    },
    {
      "name": "Markdown h4",
      "scope": "markup.heading.4",
      "foreground": "var(malachite)",
      "font_style": "bold"
    },
    {
      "name": "Markdown h5",
      "scope": "markup.heading.5",
      "foreground": "var(lapis)",
      "font_style": "bold"
    },
    {
      "name": "Markdown h6",
      "scope": "markup.heading.6",
      "foreground": "var(wine)",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "foreground": "var(tallow)",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "foreground": "var(petal)",
      "font_style": "italic"
    },
    {
      "name": "Markdown links",
      "scope": "markup.underline.link, meta.link",
      "foreground": "var(lapis)"
    },
    {
      "name": "Markdown raw",
      "scope": "markup.raw",
      "foreground": "var(malachite)"
    },
    {
      "name": "Markdown quotes",
      "scope": "markup.quote",
      "foreground": "var(incense)",
      "font_style": "italic"
    },
    {
      "name": "Markdown lists and heading marks",
      "scope": "markup.list punctuation.definition.list_item, punctuation.definition.heading",
      "foreground": "var(blood)"
    },
    {
      "name": "Mapping keys",
      "scope": "meta.mapping.key string, meta.mapping.key string.quoted, meta.mapping.key string.unquoted",
      "foreground": "var(lapis)"
    },
    {
      "name": "Key-value separators",
      "scope": "punctuation.separator.key-value, punctuation.separator.mapping.key-value",
      "foreground": "var(wine)"
    },
    {
      "name": "JSON constants",
      "scope": "constant.language.json",
      "foreground": "var(amber)",
      "font_style": "italic"
    },
    {
      "name": "YAML keys",
      "scope": "meta.mapping.key.yaml string, meta.mapping.key.yaml string.quoted, meta.mapping.key.yaml string.unquoted, entity.name.tag.yaml",
      "foreground": "var(lapis)"
    },
    {
      "name": "YAML anchors and aliases",
      "scope": "entity.name.other.anchor.yaml, variable.other.alias.yaml, punctuation.definition.anchor.yaml, punctuation.definition.alias.yaml",
      "foreground": "var(amethyst)"
    },
    {
      "name": "YAML directives and tags",
      "scope": "meta.directive.yaml, keyword.other.directive.yaml, storage.type.tag-handle.yaml",
      "foreground": "var(wine)"
    },
    {
      "name": "YAML block strings",
      "scope": "string.unquoted.block.yaml",
      "foreground": "var(malachite)"
    },
    {
      "name": "YAML constants",
      "scope": "constant.language.yaml, constant.language.boolean.yaml, constant.language.null.yaml",
      "foreground": "var(amber)",
      "font_style": "italic"
    },
    {
      "name": "Decorators and attributes (Sublime)",
      "scope": "variable.annotation, meta.annotation meta.generic-name - meta.function-call.arguments - meta.brackets - meta.group, meta.annotation punctuation.accessor - meta.function-call.arguments - meta.brackets - meta.group",
      "foreground": "var(sealwax)"
    },
    {
      "name": "Imports (Sublime)",
      "scope": "keyword.control.import-export, keyword.declaration.import",
      "foreground": "var(wine)",
      "font_style": "italic"
    },
    {
      "name": "Member access (Sublime)",
      "scope": "meta.property.object, meta.path.rust meta.path.rust variable.other.rust",
      "foreground": "var(verdigris)"
    },
    {
      "name": "Imported modules (Sublime)",
      "scope": "meta.import-name, meta.statement.import meta.path meta.generic-name",
      "foreground": "var(tallow)",
      "font_style": "italic"
    },
    {
      "name": "Type declarations (Sublime)",
      "scope": "entity.name.enum, entity.name.interface, entity.name.trait, entity.name.union, entity.name.impl, entity.name.module",
      "foreground": "var(tallow)",
      "font_style": "italic"
    },
    {
      "name": "Type parameters (Sublime)",
      "scope": "variable.parameter.generic, variable.parameter.type",
      "foreground": "var(tallow)",
      "font_style": "italic"
    },
    {
      "name": "Constant declarations (Sublime)",
      "scope": "entity.name.constant",
      "foreground": "var(amber)"
    },
    {
      "name": "JSON and YAML values (Sublime)",
      "scope": "source.json constant.language, source.yaml constant.language",
      "foreground": "var(amber)",
      "font_style": "italic"
    },
    {
      "name": "Macros (Sublime)",
      "scope": "entity.name.constant.preprocessor, entity.name.macro, support.macro",
      "foreground": "var(wine)"
    },
    {
      "name": "Constructors (Sublime)",
      "scope": "entity.name.function.constructor.js",
      "foreground": "var(blood)",
      "font_style": "italic"
    },
    {
      "name": "Interpolations and format specs (Sublime)",
      "scope": "punctuation.section.interpolation, storage.modifier.conversion, constant.other.format-spec",
      "foreground": "var(sealwax)"
    },
    {
      "name": "Parameter and optional markers (Sublime)",
      "scope": "storage.modifier.named-args-only, storage.modifier.positional-args-only, storage.modifier.optional",
      "foreground": "var(wine)"
    },
    {
      "name": "Regex internals (Sublime)",
      "scope": "source.regexp keyword.control, source.regexp keyword.operator, source.regexp keyword.other, source.regexp constant.other, source.regexp constant.character, source.regexp variable.other, source.regexp entity.name, source.regexp storage.modifier, string.regexp keyword.control, string.regexp keyword.operator, string.regexp keyword.other, string.regexp constant.other, string.regexp constant.character, string.regexp variable.other, string.regexp entity.name, string.regexp storage.modifier",
      "foreground": "var(sealwax)"
    }
  ]
}
